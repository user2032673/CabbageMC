package main

import (
	"bytes"
	"encoding/binary"
	"io"

	"github.com/go-mclib/protocol/java_protocol/net_structures"
)

// This is going to be the nerdiest file ever

func getPacketID(r *net_structures.PacketBuffer) (int32, error) {
	value, err := r.ReadVarInt()
	if err != nil {
		return 0, err
	}
	return int32(value), nil
}

func discardVarInt(r *net_structures.PacketBuffer) error {
	_, err := r.ReadVarInt()
	if err != nil {
		return err
	}
	return nil
}

func discardString(r *net_structures.PacketBuffer, maxLen int) error {
	_, err := r.ReadString(maxLen)
	if err != nil {
		return err
	}
	return nil
}

func readUnsignedShort(r *net_structures.PacketBuffer) (uint16, error) {
	short, err := r.ReadUint16()
	if err != nil {
		return 0, err
	}
	return uint16(short), nil
}

func readVarInt(r *net_structures.PacketBuffer) (int32, error) {
	return getPacketID(r)
}

func readVarLong(r *net_structures.PacketBuffer) (int64, error) {
	long, err := r.ReadVarLong()
	if err != nil {
		return 0, err
	}
	return int64(long), nil
}

func readString(r *net_structures.PacketBuffer, maxLen int) (string, error) {
	str, err := r.ReadString(maxLen)
	if err != nil {
		return "", err
	}
	return string(str), nil
}

func discardNumBytes(r *net_structures.PacketBuffer, numBytes int) error {
	for range numBytes {
		_, err := r.ReadByte()
		if err != nil {
			return err
		}
	}
	return nil
}

func writeVarInt(w *net_structures.PacketBuffer, int int) error {
	err := w.WriteVarInt(net_structures.VarInt(int))
	if err != nil {
		return err
	}
	return nil
}

func writeUUID(w *net_structures.PacketBuffer, uuid UUID) error {
	err := w.WriteUUID(net_structures.UUID(uuid))
	if err != nil {
		return err
	}
	return nil
}

func writeVarLong(w *net_structures.PacketBuffer, long int64) error {
	err := w.WriteVarLong(net_structures.VarLong(long))
	if err != nil {
		return err
	}
	return nil
}

func writeString(w *net_structures.PacketBuffer, string string) error {
	err := w.WriteString(net_structures.String(string))
	if err != nil {
		return err
	}
	return nil
}

func writeGameProfile(w *net_structures.PacketBuffer, profile Profile) error {
	profileConverted := net_structures.GameProfile{
		UUID:     net_structures.UUID(profile.Uuid),
		Username: net_structures.String(profile.Username),
	}

	err := w.WriteGameProfile(net_structures.GameProfile(profileConverted))
	if err != nil {
		return err
	}
	return nil
}

// ======================= DATATYPES

type UUID [16]byte

type Profile struct {
	Uuid     UUID
	Username string
	// Prefixed Array (16)  Properties which we're not going to implement
}

// ======================= HANDSHAKING

type C2SHandshake struct { // PacketID 0x00; HANDSHAKING
	ProtocolVersion int32
	ServerAddress   string
	ServerPort      uint16
	Intent          int32 // 1 = Status; 2 = Login; 3 = Transfer
}

// ======================= STATUS

type C2SStatusRequest struct { // PacketID 0x00; STATUS
	// No fields
}

type S2CStatusResponse struct { // PacketID 0x00; STATUS
	JSONResponse string // JSON text component
}

type C2SPingRequest struct { // PacketID 0x01; STATUS
	Timestamp int64 // May be any number, but vanilla clients will always use the timestamp in milliseconds.
}

type S2CPongResponse struct { // PacketID 0x01; STATUS
	Timestamp int64 // Should match the one sent by the client.
}

// ======================= LOGIN

type S2CLoginDisconnect struct { // PacketID 0x00
	Reason string // The reason why the player was disconnected. JSON text component
}

type C2SLoginStart struct { // PacketID 0x00
	Name       string // 16 bytes, player username
	PlayerUUID UUID   // Player UUID.
}

type S2CEncryptionRequest struct { // PacketID 0x01
	ServerID           string // 20 bytes, always empty when sent by the vanilla server.
	PublicKey          string // Actually a Prefixed Array of Bytes; the server's public key, in bytes.
	VerifyToken        string // Actually a Prefixed Array of Bytes; a sequence of random bytes generated by the server.
	ShouldAuthenticate bool   // Whether the client should attempt to authenticate through mojang servers.
}

type C2SEncryptionResponse struct { // PacketID 0x01
	SharedSecret string // Actually a Prefixed Array of Bytes; Shared Secret value, encrypted with the server's public key.
	VerifyToken  string // Actually a Prefixed Array of Bytes; Verify Token value, encrypted with the same public key as the shared secret.
}

type S2CLoginSuccess struct { // PacketID 0x02
	Profile     Profile // https://minecraft.wiki/w/Java_Edition_protocol/Packets#Game_Profile
	SessionUUID UUID    // UUID;
}

type C2SLoginPluginResponse struct { // PacketID 0x02
	MessageID int32  // Should match ID from server.
	Data      []byte // Any data, depending on the channel. Only present if the client understood the request. Typically this would be a sequence of fields using standard data types, but some unofficial channels have unusual formats. There is no length prefix that applies to all channel types, but the format specific to the channel may or may not include one or more length prefixes (e.g. for strings).
}

type S2CSetCompression struct { // PacketID 0x03
	Threshold uint32 // Maximum size of a packet before it is compressed.
}

type C2SLoginAcknowledged struct { // PacketID 0x03
	// No fields
}

type S2CLoginPluginRequest struct { // PacketID 0x04
	MessageID int32  // Generated randomly, should be unique to the connection
	Channel   string // Actually an Identifier(cabbageserver:kimchi)
	Data      []byte // Any data, depending on the channel. Max length of 1048576.
}

// (yes cookies exist but that'll be for logins later)
// ======================= CONFIG
type S2CFinishConfiguration struct { // PacketID 0x03
	// No fields
}

type C2SAcknowledgeFinishConfiguration struct { // PacketID 0x03
	// No fields
}

// ======================= PLAY
// Stubbed

// ======================== HELPERS
func readPacket(r *net_structures.PacketBuffer) (*net_structures.PacketBuffer, error) {
	len, err := readVarInt(r)
	if err != nil {
		return nil, err
	}

	packetBuffer := make([]byte, int(len))
	if _, err := io.ReadFull(r, packetBuffer); err != nil {
		return nil, err
	}
	return net_structures.NewReaderFrom(bytes.NewReader(packetBuffer)), nil
}

var ProtocolState = struct {
	Handshaking int
	Status      int
	Login       int
	Config      int
	Play        int
}{
	Handshaking: 0,
	Status:      1,
	Login:       2,
	Config:      3,
	Play:        4,
}

// ============================= HELPERS
func readC2SHandshake(r *net_structures.PacketBuffer) (*C2SHandshake, error) {
	protocolVersion, err := readVarInt(r)
	if err != nil {
		return nil, err
	}
	serverAddress, err := readString(r, 255)
	if err != nil {
		return nil, err
	}
	serverPort, err := readUnsignedShort(r)
	if err != nil {
		return nil, err
	}
	intent, err := readVarInt(r)
	if err != nil {
		return nil, err
	}

	packet := C2SHandshake{
		ProtocolVersion: protocolVersion,
		ServerAddress:   serverAddress,
		ServerPort:      serverPort,
		Intent:          intent,
	}
	return &packet, nil
}

func readStatusRequest(r *net_structures.PacketBuffer) (*C2SStatusRequest, error) {
	return &C2SStatusRequest{}, nil
}

func writeStatusResponse(w *net_structures.PacketBuffer, packet *S2CStatusResponse) error {
	var temporaryBuffer bytes.Buffer
	temp := net_structures.NewWriterTo(&temporaryBuffer)

	// Packet ID
	if err := writeVarInt(temp, 0x00); err != nil {
		return err
	}

	// Payload
	if err := writeString(temp, packet.JSONResponse); err != nil {
		return err
	}

	// Length prefix
	if err := writeVarInt(w, temporaryBuffer.Len()); err != nil {
		return err
	}

	// Packet contents
	_, err := w.Write(temporaryBuffer.Bytes())
	return err
}

func readPingRequest(r *net_structures.PacketBuffer) (*C2SPingRequest, error) {
	pingData, err := readVarLong(r)
	if err != nil {
		return nil, err
	}
	return &C2SPingRequest{
		Timestamp: pingData,
	}, nil
}

func readLoginStart(r *net_structures.PacketBuffer) (*C2SLoginStart, error) {
	username, err := readString(r, 16)
	uuidBytes, err := r.ReadFixedByteArray(16)
	uuid := UUID(uuidBytes)
	// Dirty a$$ hack but yea

	if err != nil {
		return nil, err
	}
	return &C2SLoginStart{
		Name:       username,
		PlayerUUID: uuid,
	}, nil
}

func writePongResponse(w *net_structures.PacketBuffer, packet *S2CPongResponse) error {
	// Create temporary buffer
	var temporaryBuffer bytes.Buffer
	temp := net_structures.NewWriterTo(&temporaryBuffer)

	// Packet ID
	if err := writeVarInt(temp, 0x01); err != nil {
		return err
	}

	// Timestamp (8-byte Long)
	if err := binary.Write(temp, binary.BigEndian, packet.Timestamp); err != nil {
		return err
	}

	// Write packet length
	if err := writeVarInt(w, temporaryBuffer.Len()); err != nil {
		return err
	}

	// Copy packet contents
	_, err := w.Write(temporaryBuffer.Bytes())
	return err
}

func writeFinishConfiguration(w *net_structures.PacketBuffer, packet *S2CFinishConfiguration) error {
	// Create temporary buffer
	var temporaryBuffer bytes.Buffer
	temp := net_structures.NewWriterTo(&temporaryBuffer)

	// Packet ID
	if err := writeVarInt(temp, 0x03); err != nil {
		return err
	}

	// Write packet length
	if err := writeVarInt(w, temporaryBuffer.Len()); err != nil {
		return err
	}

	// Copy packet contents
	_, err := w.Write(temporaryBuffer.Bytes())
	return err
}

func writeLoginSuccess(w *net_structures.PacketBuffer, packet *S2CLoginSuccess) error {
	// Create temporary buffer
	var temporaryBuffer bytes.Buffer
	temp := net_structures.NewWriterTo(&temporaryBuffer)

	// Packet ID
	if err := writeVarInt(temp, 0x02); err != nil {
		return err
	}
	// Write the profile itself
	if err := writeGameProfile(temp, packet.Profile); err != nil {
		return err
	}

	if err := writeUUID(temp, packet.SessionUUID); err != nil {
		return err
	}
	// Write packet length

	if err := writeVarInt(w, temporaryBuffer.Len()); err != nil {
		return err
	}

	// Copy packet contents
	_, err := w.Write(temporaryBuffer.Bytes())
	return err
}

func readLoginAcknowledged(r *net_structures.PacketBuffer) (*C2SLoginAcknowledged, error) {
	return &C2SLoginAcknowledged{}, nil
}
