package main

import (
	"io"
	"log"
	"net"

	"github.com/go-mclib/protocol/java_protocol/net_structures"
)

func main() {
	listener, err := net.Listen("tcp", "0.0.0.0:25565")
	if err != nil {
		panic(err)
	}
	defer listener.Close()
	log.Println("Minecraft 26.3 Server listening on port 25565...")
	for {
		conn, err := listener.Accept()
		if err != nil {
			log.Printf("Connection accept error: %v\n", err)
			continue
		}
		go clientHandler(conn)
	}
}

func clientHandler(conn net.Conn) {
	defer conn.Close()
	connReader := net_structures.NewReaderFrom(conn)
	connWriter := net_structures.NewWriterTo(conn)
	connectionState := ProtocolState.Handshaking

	for {
		packetData, err := readPacket(connReader)
		if err != nil {
			log.Println("readPacket: " + err.Error())
			if err == io.EOF {
				return
			}
			return
		}
		packetID, err := packetData.ReadVarInt()
		if err != nil {
			log.Println("packetID: " + err.Error())
			if err == io.EOF {
				return
			}
			return
		}
		switch connectionState {
		case ProtocolState.Dead:
			return // the defer clause earlier tears down connection
		case ProtocolState.Handshaking:
			state, dirty := handleHandshakingPacket(connWriter, packetData, packetID)
			if state == ProtocolState.Dead {
				return
			}
			if dirty {
				connectionState = state
			}
		case ProtocolState.Status:
			state, dirty := handleStatusPacket(connWriter, packetData, packetID)
			if state == ProtocolState.Dead {
				return
			}
			if dirty {
				connectionState = state
			}
		case ProtocolState.Login:
			state, dirty := handleLoginPacket(connWriter, packetData, packetID)
			if state == ProtocolState.Dead {
				return
			}
			if dirty {
				connectionState = state
			}
		case ProtocolState.Config:
			state, dirty := handleConfigPacket(connWriter, packetData, packetID)
			if state == ProtocolState.Dead {
				return
			}
			if dirty {
				connectionState = state
			}
		}

	}
}

func handleHandshakingPacket(connWriter *net_structures.PacketBuffer, packetData *net_structures.PacketBuffer, packetID net_structures.VarInt) (int, bool) {
	if packetID == 0x00 { // C2SHandshake
		packet, err := (packetData)
		if err != nil {
			log.Println("decodeC2SHandshake")
			return ProtocolState.Dead, false
		}
		if packet.ProtocolVersion != 777 {
			log.Println("proto mismatch")
			return ProtocolState.Dead, false
		}
		log.Printf("[+] %s:%d intent %d\n", packet.ServerAddress, packet.ServerPort, packet.Intent)
		if packet.Intent == 1 {
			return ProtocolState.Status, true
		}
		if packet.Intent == 2 || packet.Intent == 3 {
			return ProtocolState.Login, true
		}
	}
	return ProtocolState.Handshaking, false
}

func handleStatusPacket(connWriter *net_structures.PacketBuffer, packetData *net_structures.PacketBuffer, packetID net_structures.VarInt) (int, bool) {
	return ProtocolState.Handshaking, false
}

func handleLoginPacket(connWriter *net_structures.PacketBuffer, packetData *net_structures.PacketBuffer, packetID net_structures.VarInt) (int, bool) {
	return ProtocolState.Handshaking, false
}

func handleConfigPacket(connWriter *net_structures.PacketBuffer, packetData *net_structures.PacketBuffer, packetID net_structures.VarInt) (int, bool) {
	return ProtocolState.Handshaking, false
}
